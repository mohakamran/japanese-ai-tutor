# Copy this file to .env and fill in your values. Never commit .env.
#   macOS/Linux:  cp .env.example .env      Windows:  copy .env.example .env

# --- AI (optional on the server) ---
# Learners can save their own API key and pick a model in Settings -> AI setup.
# If you set a key here, it is used by learners who have not saved their own
# (only while SHARE_SERVER_API_KEY=true).
OPENAI_API_KEY=
# Default model for learners who have not chosen one (must support structured outputs).
OPENAI_MODEL=
# Reasoning effort for reasoning models (e.g. low, medium, high). Leave empty otherwise.
OPENAI_REASONING_EFFORT=
# Per-request timeout in seconds (5-600) and SDK retries for transient errors (0-5).
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
# Share the server key above with every signed-in user (set false for public deployments).
SHARE_SERVER_API_KEY=true

# --- Accounts & security ---
# Fernet key used to encrypt learners' saved API keys. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, a key is generated into data/.app_secret_key on first run (back it up!).
APP_SECRET_KEY=
# How many days "Keep me signed in" lasts (0 disables remembered logins).
SESSION_DAYS=14
# Set to false to stop new sign-ups (e.g. for a private deployment).
ALLOW_SIGNUPS=true
# Optional site-wide password shown before the login page.
APP_PASSWORD=

# --- Storage & logging ---
# SQLite database location (relative paths are relative to the project folder).
DATABASE_PATH=./data/japanese_tutor.db
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
