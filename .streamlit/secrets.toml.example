# Example Streamlit secrets. For local use, prefer .env instead.
# On Streamlit Community Cloud, paste these lines into App settings -> Secrets.
# Never commit a real secrets.toml file.
APP_SECRET_KEY = ""            # Fernet key that encrypts learners' saved API keys
SHARE_SERVER_API_KEY = "false" # each learner brings their own key
# OPENAI_API_KEY = ""          # optional server-wide key
# OPENAI_MODEL = ""            # optional default model
# OPENAI_REASONING_EFFORT = "low"
# ALLOW_SIGNUPS = "true"
# APP_PASSWORD = ""
